datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  CLIENT
  AGENCY
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum HeaderStatus {
  APPROVED
  PENDING
  REJECTED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
}

enum TransactionType {
  RECHARGE
  SMS_DEDUCTION
  WHATSAPP_DEDUCTION
  REFUND
  MANUAL_CREDIT
  MANUAL_DEBIT
}

// User Authentication Account
model User {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  name         String
  role         Role             @default(CLIENT)
  avatar       String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  customer     CustomerProfile?
  agency       AgencyProfile?

  @@index([email])
}

// Business Customer Profile
model CustomerProfile {
  id               String              @id @default(cuid())
  userId           String?             @unique
  user             User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName     String
  ownerName        String
  email            String              @unique
  mobile           String
  businessCategory String
  city             String
  state            String
  gstin            String?
  dltEntityId      String
  walletBalance    Decimal             @default(0.00) @db.Decimal(12, 2)
  totalMessages    Int                 @default(0)
  accountStatus    AccountStatus       @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  campaigns        Campaign[]
  transactions     WalletTransaction[]
  invoices         Invoice[]
  senderHeaders    SenderHeader[]
  whatsappProfile  WhatsAppProfile?
  contacts         Contact[]
  contactGroups    ContactGroup[]
  supportTickets   SupportTicket[]
  messageLogs      MessageLog[]

  @@index([email])
  @@index([mobile])
  @@index([businessCategory])
}

// Digital Marketing Agency
model AgencyProfile {
  id              String        @id @default(cuid())
  userId          String?       @unique
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName      String
  ownerName       String
  email           String        @unique
  phone           String
  city            String
  state           String
  walletBalance   Decimal       @default(0.00) @db.Decimal(12, 2)
  clientCount     Int           @default(0)
  pricingDiscount Decimal       @default(10.0) @db.Decimal(5, 2)
  accountStatus   AccountStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([email])
}

// Customer Wallet & Transaction Ledger
model WalletTransaction {
  id              String          @id @default(cuid())
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            TransactionType
  amount          Decimal         @db.Decimal(12, 2)
  previousBalance Decimal         @db.Decimal(12, 2)
  newBalance      Decimal         @db.Decimal(12, 2)
  reference       String
  description     String?
  channel         String?
  createdAt       DateTime        @default(now())

  @@index([customerId, createdAt])
  @@index([type])
}

// Invoices & Tax Receipts (18% GST CGST+SGST)
model Invoice {
  id                   String          @id @default(cuid())
  invoiceNumber        String          @unique
  customerId           String
  customer             CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessName         String
  ownerName            String
  gstin                String
  billingAddress       String
  amount               Decimal         @db.Decimal(12, 2)
  gst                  Decimal         @db.Decimal(12, 2)
  totalAmount          Decimal         @db.Decimal(12, 2)
  paymentStatus        String          @default("paid")
  description          String
  transactionReference String
  createdAt            DateTime        @default(now())

  @@index([customerId])
  @@index([invoiceNumber])
}

// TRAI DLT 6-Character Sender IDs (Headers)
model SenderHeader {
  id           String          @id @default(cuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName String
  header       String          // Exactly 6-char Alpha e.g. SHRFSH
  category     String          // promotional, transactional
  dltEntityId  String
  dltOperator  String          // Jio DLT, Airtel DLT, Vi DLT, BSNL DLT
  description  String?
  status       HeaderStatus    @default(PENDING)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([customerId])
  @@index([header])
  @@index([status])
}

// Meta WhatsApp Business API Telemetry & Profile
model WhatsAppProfile {
  id            String          @id @default(cuid())
  customerId    String          @unique
  customer      CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  displayName   String
  phoneNumber   String
  wabaId        String
  qualityRating String          @default("High")
  messagingTier String          @default("Tier 2 (10,000 unique recipients / 24h)")
  verifiedBadge Boolean         @default(true)
  webhookStatus String          @default("active")
  about         String?
  category      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

// Campaign Execution
model Campaign {
  id              String          @id @default(cuid())
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName    String
  campaignName    String
  channel         String          // sms, whatsapp
  messageType     String          // promotional, transactional, marketing, utility
  senderId        String?         // SMS 6-char header
  templateId      String?
  templateName    String?
  messageContent  String
  mediaUrl        String?
  totalRecipients Int
  delivered       Int             @default(0)
  failed          Int             @default(0)
  pending         Int             @default(0)
  cost            Decimal         @db.Decimal(12, 2)
  status          CampaignStatus  @default(COMPLETED)
  scheduledDate   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId, createdAt])
  @@index([channel])
  @@index([status])
}

// Reusable SMS & WhatsApp Templates
model Template {
  id             String   @id @default(cuid())
  name           String
  channel        String   // sms, whatsapp
  category       String   // promotional, transactional, marketing, utility, authentication
  language       String   @default("English")
  content        String
  dltTemplateId  String?  // TRAI DLT Template Registration ID
  metaTemplateId String?  // Meta WABA Template ID
  senderHeader   String?
  approvalStatus String   @default("approved")
  variables      String[]
  buttons        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([channel])
  @@index([approvalStatus])
}

// Contact Audience Groups
model ContactGroup {
  id          String          @id @default(cuid())
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  contacts    Contact[]

  @@index([customerId])
}

// Verified Indian Customer Contacts
model Contact {
  id              String          @id @default(cuid())
  customerId      String
  customer        CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  groupId         String?
  group           ContactGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupName       String
  name            String
  mobile          String          // 10 digits
  email           String?
  tags            String[]
  smsConsent      Boolean         @default(true)
  whatsappConsent Boolean         @default(true)
  isDnd           Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerId, mobile])
  @@index([groupId])
  @@index([isDnd])
}

// Carrier Switches & Telecommunication Suppliers
model Supplier {
  id             String   @id @default(cuid())
  name           String
  channel        String   // sms, whatsapp
  status         String   @default("connected")
  costPerMessage Decimal  @db.Decimal(6, 4)
  totalMessages  Int      @default(0)
  successRate    Decimal  @default(99.0) @db.Decimal(5, 2)
  failedCount    Int      @default(0)
  apiEndpoint    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Dynamic Carrier Routing Rules
model RoutingRule {
  id               String   @id @default(cuid())
  name             String
  channel          String   // sms, whatsapp
  messageType      String   // promotional, transactional, marketing, utility
  primarySupplier  String
  fallbackSupplier String
  priority         Int      @default(1)
  ratePerMsg       Decimal  @db.Decimal(6, 4)
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([channel, messageType, status])
}

// Platform Pricing & Wholesale Unit Margin
model PricingConfig {
  id           String   @id @default(cuid())
  channel      String   // sms, whatsapp
  type         String   @unique // promotional_sms, transactional_sms, whatsapp_marketing, whatsapp_utility
  supplierCost Decimal  @db.Decimal(6, 4)
  sellingPrice Decimal  @db.Decimal(6, 4)
  grossMargin  Decimal  @db.Decimal(6, 4)
  updatedAt    DateTime @updatedAt
}

// Support & Ticketing System
model SupportTicket {
  id           String          @id @default(cuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName String
  subject      String
  category     String
  priority     String          @default("medium")
  status       String          @default("open")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  messages     TicketMessage[]

  @@index([customerId])
  @@index([status])
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender     String        // customer, support
  senderName String
  message    String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
}

// Call Detail Records (CDR) & Message Logs
model MessageLog {
  id           String          @id @default(cuid())
  customerId   String
  customer     CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName String
  channel      String          // sms, whatsapp
  senderId     String
  recipient    String
  route        String
  cost         Decimal         @db.Decimal(6, 4)
  supplierCost Decimal         @db.Decimal(6, 4)
  status       String          @default("delivered")
  timestamp    DateTime        @default(now())

  @@index([customerId, timestamp])
  @@index([channel])
  @@index([status])
  @@index([recipient])
}
